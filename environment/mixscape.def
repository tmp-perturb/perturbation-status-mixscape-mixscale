Bootstrap: docker
From: condaforge/miniforge3:25.3.0-3

%labels
    org.opencontainers.image.title perturbation-status-mixscape
    org.opencontainers.image.version 0.4.1
    org.opencontainers.image.source https://github.com/tmp-perturb/perturbation-status-mixscape-mixscale

%post
    mamba install -y -c conda-forge \
      python=3.12.12 numpy=2.4.3 pandas=2.3.3 scipy=1.17.1 h5py=3.16.0 \
      pyyaml=6.0.3 pyarrow=24.0.0 anndata=0.12.18 psutil=7.2.2 \
      r-base=4.5.3 r-remotes r-seurat r-mixtools r-matrix r-rcpp r-rann \
      r-rcppannoy r-rcpphnsw r-irlba r-future r-future.apply r-progressr \
      r-uwot r-rtsne r-seuratobject compilers make zlib && mamba clean -afy
    Rscript -e "remotes::install_github('satijalab/seurat@084d9e40f0e669fe09a37cd0d20efb16c87d8e0c', upgrade='never', dependencies=FALSE, repos='https://cloud.r-project.org')"
    Rscript -e "remotes::install_github('immunogenomics/presto@3c97180d90d330524b5b8353a342ab2f4b990d21', upgrade='never', dependencies=FALSE, repos='https://cloud.r-project.org')"

%test
    python -c "import anndata, h5py, numpy, pandas, pyarrow, scipy, yaml"
    Rscript -e "stopifnot(packageVersion('Seurat') == '5.5.1.9003', packageVersion('presto') == '1.1.0')"
    g++ --version
